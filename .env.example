# ============================================================================
# Summit English Institute — Variables d'environnement
# ============================================================================
# COPIEZ CE FICHIER VERS .env.local ET REMPLISSEZ LES VALEURS
# NE JAMAIS COMMITTER .env.local DANS GIT
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Summit English Institute
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------------------------------------------------
# BASE DE DONNÉES
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/summit_english

# ----------------------------------------------------------------------------
# AUTHENTIFICATION
# ----------------------------------------------------------------------------
# ⚠️ OBLIGATOIRE : l'application REFUSE de démarrer en production si AUTH_SECRET
# est absent ou conserve la valeur par défaut (fail-closed, voir lib/config.ts).
# Générez une valeur forte : `openssl rand -base64 48`
AUTH_SECRET=votre_secret_authentification_ici_changez_moi_en_production
AUTH_EXPIRY=7d

# ----------------------------------------------------------------------------
# SERVICES EXTERNES (optionnels, selon besoins)
# ----------------------------------------------------------------------------
# Google AI / Gemini (pour fonctionnalités IA futures)
# GOOGLE_AI_API_KEY=votre_cle_google_ai_ici

# Stockage (si nécessaire ultérieurement)
# STORAGE_KEY=votre_cle_stockage_ici

# Analytics (si nécessaire)
# ANALYTICS_ID=votre_id_analytics_ici

# ----------------------------------------------------------------------------
# ENVIRONNEMENT
# ----------------------------------------------------------------------------
NODE_ENV=development
