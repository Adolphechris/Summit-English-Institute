# ============================================================================
# Summit English Institute — Variables d'environnement (Google Firebase Stack)
# ============================================================================
# COPIEZ CE FICHIER VERS .env.local ET REMPLISSEZ LES VALEURS
# NE JAMAIS COMMITTER .env.local DANS GIT
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Summit English Institute
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ----------------------------------------------------------------------------
# GOOGLE CLOUD FIRESTORE — Firebase Admin SDK (serveur uniquement)
# Obtenez ces valeurs depuis : Firebase Console > Paramètres du projet > Comptes de service
# Puis : Générer une nouvelle clé privée (JSON)
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=summit-english-institute
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@summit-english-institute.iam.gserviceaccount.com
# IMPORTANT : remplacez les \n littéraux de la clé privée par \\n sur une seule ligne
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_PRIVEE_ICI\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------------
# GOOGLE GEMINI AI (IA pédagogique — optionnel, fail-safe intégré)
# Obtenez votre clé depuis : https://aistudio.google.com/app/apikey
# Sans cette clé, l'app fonctionne normalement sans assistance IA
# ----------------------------------------------------------------------------
GOOGLE_AI_API_KEY=votre_cle_google_ai_ici

# ----------------------------------------------------------------------------
# AUTHENTIFICATION & SESSIONS
# ----------------------------------------------------------------------------
# ⚠️ OBLIGATOIRE : l'application REFUSE de démarrer en production si AUTH_SECRET
# est absent ou conserve la valeur par défaut (fail-closed, voir lib/config.ts).
# Générez une valeur forte : openssl rand -base64 48
AUTH_SECRET=votre_secret_authentification_ici_changez_moi_en_production
AUTH_EXPIRY=7d

# ----------------------------------------------------------------------------
# PAIEMENTS — STRIPE (international, EUR) — optionnel, 503 propre si absent
# Obtenez les clés depuis : https://dashboard.stripe.com/apikeys
# Le webhook doit pointer vers POST https://<domaine>/api/webhooks/stripe
# (événement checkout.session.completed, secret affiché à la création du endpoint)
# ----------------------------------------------------------------------------
# PAIEMENTS ACTIVÉS EN LIGNE ?
# false (ou variable absente) → la page /tarifs propose la waitlist pré-vente
# (le fondateur n’a pas encore de compte bancaire lié pour les payouts).
# true → checkout Stripe CMI/Mastercard activé et facturation par région.
# Activer APRÈS avoir lié un vrai compte bancaire au compte Stripe/Cash.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# PAIEMENTS — CMI Maroc (MAD, page hébergée 3D Pay) — scaffold inactif si absent
# Renseignez après ouverture du compte marchand CMI et validez l'algorithme
# de hash (lib/cmi.ts) contre la documentation marchand fournie.
# ----------------------------------------------------------------------------
CMI_GATEWAY_URL=
CMI_MERCHANT_ID=
CMI_STORE_KEY=

# ----------------------------------------------------------------------------
# ENVIRONNEMENT
# ----------------------------------------------------------------------------
NODE_ENV=development
